[submodule ".registry"]
	path = .registry
	url = https://github.com/r-universe-org/cran-to-git
	branch = HEAD
[submodule "biopalette"]
	path = biopalette
	url = https://github.com/evanbio/biopalette
	registered = false
[submodule "evanverse"]
	path = evanverse
	url = https://github.com/evanbio/evanverse
[submodule "ukbflow"]
	path = ukbflow
	url = https://github.com/evanbio/ukbflow
